    "tailwindcss": "4.3.1",
    "vite": "8.0.16",
    "vue": "3.5.38",
    "vue-router": "5.1.0",
    "vue-virtual-scroller": "3.0.4"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.0.3",
    "@takumi-rs/core": "1.7.0",
    "@vue/test-utils": "2.4.11",
