{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    ":separateMajorReleases"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "dependencyDashboardApproval": false,
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0
  },
  "packageRules": [
    {
      "description": "Keep vite on 7.x. @nuxt/vite-builder 4.4.8 depends on vite ^7.3.3. On vite 8 it creates a WebSocket server for both the client and SSR environments on the same HMR path, so one browser handshake is upgraded twice and vite throws an uncaughtException that kills `nuxt dev` on first page load. Reproduced on 8.1.3 and 8.1.5. Remove once Nuxt supports vite 8.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vite"],
      "allowedVersions": "<8"
    },
    {
      "description": "Ignore local goopy module (replaced via go.mod replace directive)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pypx/goopy"],
      "enabled": false
    },
    {
      "description": "Ignore our own CI-built deploy images — private GHCR packages consumed as :latest; Renovate can't auth to them (causes 'No docker auth found' warning) and must not digest-pin them",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/mattstrayer/pypx/**"],
      "enabled": false
    },
    {
      "description": "Catch-all: batch all remaining npm minor/patch into one rolling PR, automerged when CI is green. Specific ecosystem rules below override groupName and automerge. Majors stay individual.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "web: misc (non-major)",
      "automerge": true
    },
    {
      "description": "Nuxt + Vite move together — nuxt releases track vite compatibility",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "nuxt",
        "@nuxt/**",
        "@nuxtjs/**",
        "vite",
        "@vitejs/**",
        "nitropack"
      ],
      "groupName": "web: nuxt + vite",
      "automerge": false
    },
    {
      "description": "Vue ecosystem",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vue",
        "vue-router",
        "@vue/**",
        "@vueuse/**"
      ],
      "groupName": "web: vue",
      "automerge": false
    },
    {
      "description": "Tailwind — @tailwindcss/vite is versioned in lockstep with tailwindcss",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**"
      ],
      "groupName": "web: tailwind",
      "automerge": false
    },
    {
      "description": "TypeScript + vue-tsc — vue-tsc tracks TS compiler compatibility",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "typescript",
        "vue-tsc"
      ],
      "groupName": "web: typescript",
      "automerge": false
    },
    {
      "description": "oxc tooling — plugin API must stay compatible with the oxlint version (if oxlint-plugin-complexity breaks, pin oxlint to the last working version)",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "oxlint",
        "oxlint-plugin-**",
        "oxfmt"
      ],
      "groupName": "web: oxc",
      "automerge": false
    },
    {
      "description": "Test tooling (must come after vue/nuxt rules so @vue/test-utils and @nuxt/test-utils land here)",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "happy-dom",
        "@vue/test-utils",
        "@nuxt/test-utils"
      ],
      "groupName": "web: testing",
      "automerge": false
    },
    {
      "description": "Go dependencies (both api and goopy modules)",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "api: go dependencies"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "ci: github actions"
    },
    {
      "description": "Docker images (compose + Dockerfiles)",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "infra: docker"
    },
    {
      "description": "Go toolchain moves atomically: go directive in go.mod files + golang base image (must come after the docker rule to pull golang out of the docker group)",
      "matchDepNames": ["go", "golang"],
      "matchManagers": ["gomod", "dockerfile"],
      "groupName": "go toolchain"
    },
    {
      "description": "Automerge non-major test tooling updates",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "happy-dom",
        "@vue/test-utils",
        "@nuxt/test-utils"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge patch-level Go dependency updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge GitHub Actions minor/patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
