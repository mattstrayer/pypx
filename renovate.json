{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    ":separateMajorReleases",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "dependencyDashboardApproval": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0
  },
  "packageRules": [
    {
      "description": "Ignore local goopy module (replaced via go.mod replace directive)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pypx/goopy"],
      "enabled": false
    },
    {
      "description": "Group Nuxt ecosystem updates",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "nuxt",
        "@nuxt/**",
        "@nuxtjs/**"
      ],
      "groupName": "nuxt ecosystem"
    },
    {
      "description": "Group Vue ecosystem updates",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vue",
        "vue-router",
        "@vue/**",
        "@vueuse/**"
      ],
      "groupName": "vue ecosystem"
    },
    {
      "description": "Group test tooling updates",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vitest",
        "happy-dom",
        "@vue/test-utils",
        "@nuxt/test-utils"
      ],
      "groupName": "test tooling"
    },
    {
      "description": "Group Go dependencies",
      "matchManagers": ["gomod"],
      "groupName": "go dependencies",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group Docker-related updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Automerge non-major updates for test tooling",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vitest",
        "happy-dom",
        "@vue/test-utils",
        "@nuxt/test-utils"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge patch-level Go dependency updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge GitHub Actions minor/patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
