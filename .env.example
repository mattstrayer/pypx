# Domain — used by Caddy for routing
DOMAIN=pypx.app

# Port the Go API server listens on (default: 8080)
API_PORT=8080

# Path to SQLite database file (default: pypx.db)
SQLITE_PATH=pypx.db

# Server-side API base URL for Nuxt SSR (default: http://localhost:8080/api)
NUXT_API_BASE=http://localhost:8080/api

# Public/client-side API base URL (default: /api)
NUXT_PUBLIC_API_BASE=/api

# Optional: GitHub API token — increases rate limit from 60/hr to 5000/hr
# Create at: https://github.com/settings/tokens (no scopes needed, public repo access only)
GITHUB_TOKEN=

# Optional: GitLab API token for GitLab-hosted packages
GITLAB_TOKEN=

# EthicalAds — leave NUXT_PUBLIC_ADS_PUBLISHER empty to disable ads entirely.
NUXT_PUBLIC_ADS_PUBLISHER=
# Placement format: "image" or "text".
NUXT_PUBLIC_ADS_TYPE=image
